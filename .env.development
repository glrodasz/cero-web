# CONFIG
NEXT_PUBLIC_MAXIMUM_IN_PRIORITY_TASKS=2
NEXT_PUBLIC_MAXIMUM_BACKLOG_QUANTITY=4

# DATA SOURCE
# Selects the backend. `config/index.js` derives the browser's API URL from it
# (`/api/local`) and `datasources/index.js` derives the storage, so the two
# cannot disagree. See `config/dataSource.js`.
NEXT_PUBLIC_DATA_SOURCE=json-server

# URLS
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# JSON SERVER
# Only where `json-server` listens — it no longer selects anything.
JSON_SERVER_URL=http://localhost:3001

# AUTH0
AUTH0_BASE_URL=$NEXT_PUBLIC_BASE_URL
AUTH0_ISSUER_BASE_URL=https://undefined-academy.eu.auth0.com
AUTH0_CLIENT_ID=ZKRcm0dG879ol9TxBju96pMAubYb8ZhD
