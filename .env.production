# CONFIG
NEXT_PUBLIC_MAXIMUM_IN_PRIORITY_TASKS=2
NEXT_PUBLIC_MAXIMUM_BACKLOG_QUANTITY=4

# DATA SOURCE
# The demo: routes answer on `/api/demo` and read the Redis backed store. A real
# production deployment overrides this on the hosting dashboard with
# `NEXT_PUBLIC_DATA_SOURCE=api` plus `NEXT_PUBLIC_API_URL=https://…`, which
# points the browser straight at the backend and leaves these routes unused.
NEXT_PUBLIC_DATA_SOURCE=memory
