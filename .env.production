# CONFIG
NEXT_PUBLIC_MAXIMUM_IN_PRIORITY_TASKS=2
NEXT_PUBLIC_MAXIMUM_BACKLOG_QUANTITY=4

# DATA SOURCE
# The demo: each visitor's data lives in their own browser's `localStorage`,
# seeded from `db.seed.json`, and no API route or external service is involved.
# A real production deployment overrides this on the hosting dashboard with
# `NEXT_PUBLIC_DATA_SOURCE=api` plus `NEXT_PUBLIC_API_URL=https://…`, which
# points the browser straight at the backend.
NEXT_PUBLIC_DATA_SOURCE=local-storage
