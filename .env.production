# CONFIG
NEXT_PUBLIC_MAXIMUM_IN_PRIORITY_TASKS=2
NEXT_PUBLIC_MAXIMUM_BACKLOG_QUANTITY=4

# API
# Deliberately unset: with no `NEXT_PUBLIC_API_URL` each visitor's data lives in
# their own browser's `localStorage`, seeded from `db.seed.json`, and no API
# route or external service is involved. A deployment with a real backend sets
# `NEXT_PUBLIC_API_URL=https://…` on the hosting dashboard instead.
