# CONFIG
# Without these `MAXIMUM_IN_PRIORITY_TASKS` is `NaN`, and every `length >= NaN`
# check silently returns false — the in progress cap would not exist under test.
NEXT_PUBLIC_MAXIMUM_IN_PRIORITY_TASKS=2
NEXT_PUBLIC_MAXIMUM_BACKLOG_QUANTITY=4

# API
# This app's own API routes on `/api/test`, with the committed arrays in
# `datasources/fixtures/` behind them. Same CRUD as the demo store, but the data
# is fixed and lives only for the life of the process, so a run starts from a
# known state and needs no `json-server` and no `db.json`.
NEXT_PUBLIC_API_URL=/api/test
